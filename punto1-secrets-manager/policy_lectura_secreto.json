{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LeerSoloEsteSecreto",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret"
      ],
      "Resource": "arn:aws:secretsmanager:us-east-1:<ACCOUNT_ID>:secret:taller/punto1/credenciales-prueba-*"
    }
  ]
}
